# Browser-facing auth origin (the Next.js app). Must match server BETTER_AUTH_URL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Express upstream that the Next.js /api/auth proxy forwards to (server-side only).
AUTH_UPSTREAM_URL=http://localhost:4000

# Express API used for profiles, uploads and payments.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: used by Stripe.js if you switch to embedded checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
